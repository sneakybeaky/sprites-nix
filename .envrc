# shellcheck shell=bash
#
# Enter the flake's dev shell (sprite CLI, home-manager, jq, shellcheck) on cd.
#
# `use flake` comes from nix-direnv when it is installed, and from direnv's own
# stdlib (>= 2.30) otherwise. Without nix-direnv the shell is re-evaluated on
# every reload and holds no GC root, so enable
# `programs.direnv.nix-direnv.enable` in your home config for caching.
use flake

# Reload when the inputs or the guest home module change.
watch_file flake.nix
watch_file flake.lock
watch_file home/sprite.nix
